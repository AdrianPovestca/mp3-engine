@app.get("/api/search")
async def search_songs(q: str, limit: int = 10):
    query = q.strip()
    if not query:
        raise HTTPException(status_code=400, detail="Enter a song title or artist.")
    if len(query) > 200:
        raise HTTPException(status_code=400, detail="Search query is too long.")

    limit = max(1, min(limit, 25))

    try:
        async with httpx.AsyncClient(timeout=20) as client:
            response = await client.get(
                "https://itunes.apple.com/search",
                params={
                    "term": query,
                    "media": "music",
                    "entity": "song",
                    "limit": limit,
                    "country": "US",
                },
            )
            response.raise_for_status()
            data = response.json()

        results = []
        for item in data.get("results", []):
            results.append({
                "title": item.get("trackName"),
                "artist": item.get("artistName"),
                "album": item.get("collectionName"),
                "duration_ms": item.get("trackTimeMillis"),
                "preview_url": item.get("previewUrl"),
                "artwork_url": item.get("artworkUrl100"),
                "store_url": item.get("trackViewUrl"),
                "source": "Apple iTunes",
            })

        return {
            "query": query,
            "count": len(results),
            "results": results,
            "note": "Preview URLs are short samples when available, not full-song downloads.",
        }

    except (httpx.HTTPError, ValueError) as exc:
        raise HTTPException(
            status_code=502,
            detail=f"Music search failed: {exc}",
        ) from exc
